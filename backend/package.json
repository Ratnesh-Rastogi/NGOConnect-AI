{
    "name":  "ngo-connect-api",
    "version":  "0.0.0",
    "private":  true,
    "type":  "module",
    "scripts":  {
                    "dev":  "tsx watch src/index.ts",
                    "build":  "node ./build.mjs",
                    "start":  "node --enable-source-maps ./dist/index.mjs",
                    "seed":  "tsx src/seed.ts",
                    "test":  "tsx --test src/smoke.test.ts",
                    "typecheck":  "tsc -p tsconfig.json --noEmit"
                },
    "dependencies":  {
                         "bcryptjs":  "^3.0.3",
                         "cookie-parser":  "^1.4.7",
                         "cors":  "^2.8.6",
                         "drizzle-orm":  "^0.45.2",
                         "express":  "^5.2.1",
                         "jsonwebtoken":  "^9.0.3",
                         "pino":  "^9.14.0",
                         "pino-http":  "^10.5.0",
                         "tsx":  "4.23.13"
                     },
    "devDependencies":  {
                            "@types/cookie-parser":  "^1.4.10",
                            "@types/cors":  "^2.8.19",
                            "@types/express":  "^5.0.6",
                            "@types/jsonwebtoken":  "^9.0.10",
                            "@types/node":  "^25.3.3",
                            "esbuild":  "0.25.8",
                            "esbuild-plugin-pino":  "^2.3.3",
                            "pino-pretty":  "^13.1.3",
                            "thread-stream":  "3.1.0"
                        }
}
