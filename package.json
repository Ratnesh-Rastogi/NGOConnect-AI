{
    "name":  "ngo-connect-ai",
    "version":  "1.0.0",
    "private":  true,
    "workspaces":  [
                       "frontend",
                       "backend",
                       "shared/*"
                   ],
    "scripts":  {
                    "dev:frontend":  "npm run dev --workspace=frontend",
                    "dev:backend":  "npm run dev --workspace=backend",
                    "build":  "npm run build --workspaces --if-present",
                    "typecheck":  "npm run typecheck --workspaces --if-present"
                },
    "devDependencies":  {
                            "prettier":  "^3.9.6",
                            "typescript":  "~5.9.3"
                        }
}